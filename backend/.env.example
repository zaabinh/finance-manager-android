SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=5433
DB_NAME=finance_manager_local
DB_USERNAME=finance_user
DB_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional only in dev: without files, a new RSA key is generated on every startup.
# Required in staging/prod: PKCS#8 private key and X.509 public key resource locations.
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY=
AUTH_JWT_ISSUER=fintrack-api
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=30d
AUTH_OTP_TTL=10m
# Concurrent-refresh window before a replayed refresh token counts as theft (max 1m).
AUTH_REFRESH_REUSE_GRACE_PERIOD=20s
# true = refresh token in HttpOnly cookie (web); false = JSON body (Android).
AUTH_REFRESH_COOKIE=false
RESEND_API_KEY=
MAIL_FROM=
# Public URL of the email logo; defaults to this backend's /email/logo.png.
# MAIL_LOGO_URL=https://api.example.com/email/logo.png
