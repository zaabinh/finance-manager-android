<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 01_TransactionList — v2 (Lịch sử) 658:4618; states 658:4772 Empty, 658:4793 No results,
     658:4814 Loading, 658:4835 Error, 658:4856 Saved toast (Snackbar with view_toast).
     rvTransactions items: view_section_header (date group, action GONE) + item_transaction.
     Search field is NOT in Figma (P5 decision 4 omitted it); added per the implementation request. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app_canvas"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarTransactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_app_canvas"
            app:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbarTransactions"
                style="@style/Widget.App.Toolbar"
                app:title="@string/transaction_history_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_16"
                android:paddingEnd="@dimen/spacing_16"
                app:layout_scrollFlags="scroll|enterAlways">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilTransactionSearch"
                    style="@style/Widget.App.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    app:endIconMode="clear_text"
                    app:startIconContentDescription="@null"
                    app:startIconDrawable="@drawable/ic_search">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTransactionSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/transaction_search_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:clipToPadding="false"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupTransactionType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/transaction_filters_label"
                        app:chipSpacingHorizontal="@dimen/spacing_8"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFilterAll"
                            style="@style/Widget.App.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/transaction_filter_all" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFilterExpense"
                            style="@style/Widget.App.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/transaction_type_expense" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFilterIncome"
                            style="@style/Widget.App.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/transaction_type_income" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFilterTransfer"
                            style="@style/Widget.App.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/transaction_type_transfer" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_target_min"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTransactionMonth"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:textAppearance="@style/TextAppearance.App.TitleSection"
                        tools:text="Tháng 10/2026" />

                    <TextView
                        android:id="@+id/tvChangeMonth"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_target_min"
                        android:layout_marginStart="@dimen/spacing_8"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:text="@string/transaction_change_month"
                        android:textAppearance="@style/TextAppearance.App.Label"
                        android:textColor="@color/color_primary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMonthSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:textAppearance="@style/TextAppearance.App.BodySecondary"
                    tools:text="Chi 3.245.000&#160;đ · Thu 18.500.000&#160;đ" />

                <TextView
                    android:id="@+id/tvActiveTransactionFilters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.App.BodySecondary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvMonthSummaryNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/transaction_summary_excludes_transfer"
                    android:textAppearance="@style/TextAppearance.App.BodySecondary" />
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTransactions"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/spacing_16"
                android:paddingTop="@dimen/spacing_8"
                android:paddingEnd="@dimen/spacing_16"
                android:paddingBottom="@dimen/spacing_16"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="6"
                tools:listitem="@layout/item_transaction" />

            <include
                android:id="@+id/stateLoadingList"
                layout="@layout/view_state_loading_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_16"
                android:layout_marginTop="@dimen/spacing_8"
                android:layout_marginEnd="@dimen/spacing_16"
                android:visibility="gone" />

            <include
                android:id="@+id/stateEmpty"
                layout="@layout/view_state_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav" />
</LinearLayout>
