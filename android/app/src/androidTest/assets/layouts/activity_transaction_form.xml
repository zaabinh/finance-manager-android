<?xml version="1.0" encoding="utf-8"?>
<!-- Figma Transaction/Form 658:4617 in screens:
     658:5712 Create (Expense, default), Income via segmented, 658:5805 Edit (title transaction_edit_title,
     CTA btn_save_changes, values prefilled), 674:7013 Transfer (btnTypeTransfer checked:
     groupExpenseIncome GONE, groupTransfer VISIBLE, amount label transfer_amount_label, sign GONE,
     CTA transfer_save, title transfer_add_title).
     Validation 658:5790: amount error (view_amount_input) + fieldCategory Widget.App.FieldSelector.Error look.
     Same-wallet 674:7171: fieldDestinationWallet error look + feedbackSameWallet VISIBLE, feedbackTransferInfo GONE.
     Keyboard 658:5795: actionBarSave stays above the IME (needs windowSoftInputMode=adjustResize). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app_canvas"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarTransactionForm"
        style="@style/Widget.App.Toolbar.Back"
        app:title="@string/transaction_add_title" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollTransactionForm"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_16"
            android:paddingTop="@dimen/spacing_8"
            android:paddingEnd="@dimen/spacing_16"
            android:paddingBottom="@dimen/spacing_16">

            <include
                android:id="@+id/segmentedTransactionType"
                layout="@layout/view_transaction_type_segmented" />

            <include
                android:id="@+id/amountInput"
                layout="@layout/view_amount_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16" />

            <!-- Expense / Income: Danh mục + Ví -->
            <LinearLayout
                android:id="@+id/groupExpenseIncome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/fieldCategory"
                    style="@style/Widget.App.FieldSelector"
                    android:layout_marginTop="@dimen/spacing_16">

                    <ImageView
                        android:id="@+id/ivCategoryIcon"
                        style="@style/Widget.App.FieldSelector.Icon"
                        android:src="@drawable/ic_category" />

                    <LinearLayout style="@style/Widget.App.FieldSelector.Content">

                        <TextView
                            android:id="@+id/tvCategoryLabel"
                            style="@style/Widget.App.FieldSelector.Label"
                            android:text="@string/transaction_category_label" />

                        <TextView
                            android:id="@+id/tvCategoryValue"
                            style="@style/Widget.App.FieldSelector.Value"
                            android:hint="@string/transaction_category_placeholder" />
                    </LinearLayout>

                    <ImageView style="@style/Widget.App.FieldSelector.Chevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/fieldWallet"
                    style="@style/Widget.App.FieldSelector"
                    android:layout_marginTop="@dimen/spacing_16">

                    <ImageView
                        android:id="@+id/ivWalletIcon"
                        style="@style/Widget.App.FieldSelector.Icon"
                        android:src="@drawable/ic_banknote" />

                    <LinearLayout style="@style/Widget.App.FieldSelector.Content">

                        <TextView
                            android:id="@+id/tvWalletLabel"
                            style="@style/Widget.App.FieldSelector.Label"
                            android:text="@string/transaction_wallet_label" />

                        <TextView
                            android:id="@+id/tvWalletValue"
                            style="@style/Widget.App.FieldSelector.Value"
                            android:hint="@string/transaction_wallet_placeholder"
                            tools:text="Tiền mặt" />
                    </LinearLayout>

                    <ImageView style="@style/Widget.App.FieldSelector.Chevron" />
                </LinearLayout>
            </LinearLayout>

            <!-- Transfer: Ví nguồn + Ví đích + info / same-wallet error -->
            <LinearLayout
                android:id="@+id/groupTransfer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/fieldSourceWallet"
                    style="@style/Widget.App.FieldSelector"
                    android:layout_marginTop="@dimen/spacing_16">

                    <ImageView
                        android:id="@+id/ivSourceWalletIcon"
                        style="@style/Widget.App.FieldSelector.Icon"
                        android:src="@drawable/ic_landmark" />

                    <LinearLayout style="@style/Widget.App.FieldSelector.Content">

                        <TextView
                            android:id="@+id/tvSourceWalletLabel"
                            style="@style/Widget.App.FieldSelector.Label"
                            android:text="@string/transfer_source_wallet_label" />

                        <TextView
                            android:id="@+id/tvSourceWalletValue"
                            style="@style/Widget.App.FieldSelector.Value"
                            android:hint="@string/transaction_wallet_placeholder"
                            tools:text="Techcombank · 15.736.000&#160;đ" />
                    </LinearLayout>

                    <ImageView style="@style/Widget.App.FieldSelector.Chevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/fieldDestinationWallet"
                    style="@style/Widget.App.FieldSelector"
                    android:layout_marginTop="@dimen/spacing_16">

                    <ImageView
                        android:id="@+id/ivDestinationWalletIcon"
                        style="@style/Widget.App.FieldSelector.Icon"
                        android:src="@drawable/ic_wallet_outline" />

                    <LinearLayout style="@style/Widget.App.FieldSelector.Content">

                        <TextView
                            android:id="@+id/tvDestinationWalletLabel"
                            style="@style/Widget.App.FieldSelector.Label"
                            android:text="@string/transfer_destination_wallet_label" />

                        <TextView
                            android:id="@+id/tvDestinationWalletValue"
                            style="@style/Widget.App.FieldSelector.Value"
                            android:hint="@string/transfer_destination_wallet_placeholder" />
                    </LinearLayout>

                    <ImageView style="@style/Widget.App.FieldSelector.Chevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/feedbackTransferInfo"
                    style="@style/Widget.App.FeedbackInline.Info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_16"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/Widget.App.FeedbackInline.Icon"
                        android:src="@drawable/ic_info" />

                    <TextView
                        style="@style/Widget.App.FeedbackInline.Message"
                        android:text="@string/transfer_info_note" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/feedbackSameWallet"
                    style="@style/Widget.App.FeedbackInline.Error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_16"
                    android:accessibilityLiveRegion="polite"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        style="@style/Widget.App.FeedbackInline.Icon"
                        android:src="@drawable/ic_circle_alert" />

                    <TextView
                        style="@style/Widget.App.FeedbackInline.Message"
                        android:text="@string/transfer_same_wallet_error" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/fieldDate"
                style="@style/Widget.App.FieldSelector"
                android:layout_marginTop="@dimen/spacing_16">

                <ImageView
                    android:id="@+id/ivDateIcon"
                    style="@style/Widget.App.FieldSelector.Icon"
                    android:src="@drawable/ic_calendar" />

                <LinearLayout style="@style/Widget.App.FieldSelector.Content">

                    <TextView
                        android:id="@+id/tvDateLabel"
                        style="@style/Widget.App.FieldSelector.Label"
                        android:text="@string/transaction_date_label" />

                    <TextView
                        android:id="@+id/tvDateValue"
                        style="@style/Widget.App.FieldSelector.Value"
                        tools:text="Hôm nay · 26/10/2026, 15:45" />
                </LinearLayout>

                <ImageView style="@style/Widget.App.FieldSelector.Chevron" />
            </LinearLayout>

            <TextView
                style="@style/Widget.App.FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:labelFor="@id/etTransactionPayee"
                android:text="@string/finance_payee_label" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.App.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTransactionPayee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/transaction_store_label"
                    android:inputType="textCapWords"
                    android:maxLength="160"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvNoteLabel"
                style="@style/Widget.App.FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:labelFor="@id/etTransactionNote"
                android:text="@string/transaction_note_label" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTransactionNote"
                style="@style/Widget.App.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTransactionNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/transaction_note_hint"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="2000"
                    android:maxLines="4" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/actionBarSave"
        style="@style/Widget.App.BottomActionBar">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveTransaction"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/transaction_save" />
    </LinearLayout>
</LinearLayout>
