<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app_canvas"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/spacing_24">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_48"
            android:text="@string/forgot_password_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_amount_medium"
            android:textStyle="bold" />

        <!-- Form Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_32"
            android:orientation="vertical">

            <!-- Field: Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_email"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_body_primary"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/spacing_8"
                android:autofillHints="emailAddress"
                android:background="@drawable/bg_input_field"
                android:drawableStart="@drawable/ic_email"
                android:drawablePadding="@dimen/spacing_12"
                android:hint="@string/hint_email"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="@dimen/spacing_16"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_disabled"
                android:textSize="@dimen/text_size_body_primary" />

            <!-- Send Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSend"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_24"
                android:background="@drawable/bg_button_primary"
                android:text="@string/btn_send"
                android:textAllCaps="false"
                android:textColor="@color/text_on_primary"
                android:textSize="@dimen/text_size_button"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Back to Login Link -->
        <TextView
            android:id="@+id/tvBackToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20"
            android:padding="@dimen/spacing_8"
            android:text="@string/action_back_to_login"
            android:textColor="@color/color_primary"
            android:textSize="@dimen/text_size_body_primary"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>