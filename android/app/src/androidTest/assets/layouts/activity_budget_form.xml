<?xml version="1.0" encoding="utf-8"?>
<!-- Figma Budget Add v2 676:8695 and Edit v2 676:8919.
     Binding: set tvAmountLabel to budget_limit_label; hide tvAmountSign.
     Edit: budget_edit_title, btn_save_changes, and prefilled values. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app_canvas"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarBudgetForm"
        style="@style/Widget.App.Toolbar.Back"
        app:title="@string/budget_add_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_16"
            android:paddingTop="@dimen/spacing_8"
            android:paddingEnd="@dimen/spacing_16"
            android:paddingBottom="@dimen/spacing_16">

            <!-- Category selector -->
            <LinearLayout
                android:id="@+id/fieldBudgetCategory"
                style="@style/Widget.App.FieldSelector"
                android:layout_marginTop="@dimen/spacing_8">

                <ImageView
                    android:id="@+id/ivBudgetCatIcon"
                    style="@style/Widget.App.FieldSelector.Icon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_category" />

                <LinearLayout style="@style/Widget.App.FieldSelector.Content">

                    <TextView
                        style="@style/Widget.App.FieldSelector.Label"
                        android:text="@string/transaction_category_label" />

                    <TextView
                        android:id="@+id/tvBudgetCatValue"
                        style="@style/Widget.App.FieldSelector.Value"
                        android:hint="@string/transaction_category_placeholder"
                        tools:text="Ăn uống &amp; Cafe" />
                </LinearLayout>

                <ImageView style="@style/Widget.App.FieldSelector.Chevron" />
            </LinearLayout>

            <!-- Amount input -->
            <include
                android:id="@+id/amountInputBudget"
                layout="@layout/view_amount_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16" />

            <!-- Period / Month selector -->
            <LinearLayout
                android:id="@+id/fieldBudgetPeriod"
                style="@style/Widget.App.FieldSelector"
                android:layout_marginTop="@dimen/spacing_16">

                <ImageView
                    style="@style/Widget.App.FieldSelector.Icon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_calendar" />

                <LinearLayout style="@style/Widget.App.FieldSelector.Content">

                    <TextView
                        style="@style/Widget.App.FieldSelector.Label"
                        android:text="@string/budget_period_label" />

                    <TextView
                        android:id="@+id/tvBudgetPeriodValue"
                        style="@style/Widget.App.FieldSelector.Value"
                        tools:text="Tháng 10/2026" />
                </LinearLayout>

                <ImageView style="@style/Widget.App.FieldSelector.Chevron" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        style="@style/Widget.App.BottomActionBar">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveBudget"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_create_budget" />
    </LinearLayout>
</LinearLayout>
