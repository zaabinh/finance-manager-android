<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app_canvas"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/spacing_24">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_48"
            android:text="@string/change_password_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_amount_medium"
            android:textStyle="bold" />

        <!-- Form Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_32"
            android:orientation="vertical">

            <!-- Field 1: Enter new password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_enter_new_password"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_body_primary"
                android:textStyle="bold" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/spacing_8"
                android:background="@drawable/bg_input_field">

                <EditText
                    android:id="@+id/etNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toStartOf="@+id/ivToggleNewPassword"
                    android:autofillHints="newPassword"
                    android:background="@null"
                    android:drawableStart="@drawable/ic_lock"
                    android:drawablePadding="@dimen/spacing_12"
                    android:hint="@string/hint_password"
                    android:inputType="textPassword"
                    android:paddingHorizontal="@dimen/spacing_16"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_disabled"
                    android:textSize="@dimen/text_size_body_primary" />

                <ImageView
                    android:id="@+id/ivToggleNewPassword"
                    android:layout_width="@dimen/spacing_32"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/label_enter_new_password"
                    android:padding="@dimen/spacing_8"
                    android:src="@drawable/ic_eye_close" />
            </RelativeLayout>

            <!-- Field 2: Confirm password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:text="@string/label_confirm_new_password"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_body_primary"
                android:textStyle="bold" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/spacing_8"
                android:background="@drawable/bg_input_field">

                <EditText
                    android:id="@+id/etConfirmNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toStartOf="@+id/ivToggleConfirmNewPassword"
                    android:autofillHints="newPassword"
                    android:background="@null"
                    android:drawableStart="@drawable/ic_lock"
                    android:drawablePadding="@dimen/spacing_12"
                    android:hint="@string/hint_password"
                    android:inputType="textPassword"
                    android:paddingHorizontal="@dimen/spacing_16"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_disabled"
                    android:textSize="@dimen/text_size_body_primary" />

                <ImageView
                    android:id="@+id/ivToggleConfirmNewPassword"
                    android:layout_width="@dimen/spacing_32"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/label_confirm_new_password"
                    android:padding="@dimen/spacing_8"
                    android:src="@drawable/ic_eye_close" />
            </RelativeLayout>

            <!-- Submit Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_24"
                android:background="@drawable/bg_button_primary"
                android:text="@string/btn_submit"
                android:textAllCaps="false"
                android:textColor="@color/text_on_primary"
                android:textSize="@dimen/text_size_button"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>