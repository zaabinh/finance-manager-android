<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 05_TransactionReview — v2 658:6660 (shown), 658:6770 unreadable, 658:6788 multi-item.
     Binding code sets amount label receipt_amount_label (view_amount_input default is "Số tiền").
     Uncertain fields use Widget.App.FieldSelector.Uncertain + Label.Uncertain; switch to the normal
     style once the user edits them.
     Multi-item: feedbackReview Info tone (backgroundTint bg_surface_secondary, ic_info, receipt_review_multi_item).
     Unreadable: feedbackReview + groupReviewFields + btnConfirmReceipt + btnAddReceipt + btnRescan GONE;
     stateUnreadable VISIBLE (ic_cloud_off, receipt_unreadable_*, btnStatePrimary "Chụp lại"); btnManualEntry VISIBLE. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app_canvas"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarReceiptReview"
        style="@style/Widget.App.Toolbar.Back"
        app:title="@string/receipt_review_title"
        tools:title="Kiểm tra hóa đơn · 1/3" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_16"
            android:paddingTop="@dimen/spacing_8"
            android:paddingEnd="@dimen/spacing_16"
            android:paddingBottom="@dimen/spacing_16">

            <LinearLayout
                android:id="@+id/feedbackReview"
                style="@style/Widget.App.FeedbackInline.Warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_12"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivReviewFeedbackIcon"
                    style="@style/Widget.App.FeedbackInline.Icon"
                    android:src="@drawable/ic_triangle_alert" />

                <TextView
                    android:id="@+id/tvReviewFeedback"
                    style="@style/Widget.App.FeedbackInline.Message"
                    tools:text="2 thông tin Đồng chưa chắc chắn (viền vàng). Hãy kiểm tra trước khi lưu." />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/groupReviewFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/amountInput"
                    layout="@layout/view_amount_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:id="@+id/fieldStore"
                    style="@style/Widget.App.FieldSelector"
                    android:layout_marginTop="@dimen/spacing_12">

                    <ImageView
                        style="@style/Widget.App.FieldSelector.Icon"
                        android:src="@drawable/ic_receipt" />

                    <LinearLayout style="@style/Widget.App.FieldSelector.Content">

                        <TextView
                            android:id="@+id/tvStoreLabel"
                            style="@style/Widget.App.FieldSelector.Label"
                            android:text="@string/transaction_store_label" />

                        <TextView
                            android:id="@+id/tvStoreValue"
                            style="@style/Widget.App.FieldSelector.Value"
                            tools:text="Highlands Coffee" />
                    </LinearLayout>

                    <ImageView style="@style/Widget.App.FieldSelector.Chevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/fieldCategory"
                    style="@style/Widget.App.FieldSelector.Uncertain"
                    android:layout_marginTop="@dimen/spacing_12">

                    <ImageView
                        android:id="@+id/ivCategoryIcon"
                        style="@style/Widget.App.FieldSelector.Icon"
                        android:src="@drawable/ic_category" />

                    <LinearLayout style="@style/Widget.App.FieldSelector.Content">

                        <TextView
                            android:id="@+id/tvCategoryLabel"
                            style="@style/Widget.App.FieldSelector.Label.Uncertain"
                            android:text="@string/receipt_category_suggested_label" />

                        <TextView
                            android:id="@+id/tvCategoryValue"
                            style="@style/Widget.App.FieldSelector.Value"
                            android:hint="@string/transaction_category_placeholder"
                            tools:text="Ăn uống &amp; Cafe" />
                    </LinearLayout>

                    <ImageView style="@style/Widget.App.FieldSelector.Chevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/fieldDate"
                    style="@style/Widget.App.FieldSelector.Uncertain"
                    android:layout_marginTop="@dimen/spacing_12">

                    <ImageView
                        style="@style/Widget.App.FieldSelector.Icon"
                        android:src="@drawable/ic_calendar" />

                    <LinearLayout style="@style/Widget.App.FieldSelector.Content">

                        <TextView
                            android:id="@+id/tvDateLabel"
                            style="@style/Widget.App.FieldSelector.Label.Uncertain"
                            android:text="@string/receipt_date_suggested_label" />

                        <TextView
                            android:id="@+id/tvDateValue"
                            style="@style/Widget.App.FieldSelector.Value"
                            tools:text="26/10/2026, 15:45" />
                    </LinearLayout>

                    <ImageView style="@style/Widget.App.FieldSelector.Chevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/fieldWallet"
                    style="@style/Widget.App.FieldSelector"
                    android:layout_marginTop="@dimen/spacing_12">

                    <ImageView
                        style="@style/Widget.App.FieldSelector.Icon"
                        android:src="@drawable/ic_landmark" />

                    <LinearLayout style="@style/Widget.App.FieldSelector.Content">

                        <TextView
                            android:id="@+id/tvWalletLabel"
                            style="@style/Widget.App.FieldSelector.Label"
                            android:text="@string/transaction_wallet_label" />

                        <TextView
                            android:id="@+id/tvWalletValue"
                            style="@style/Widget.App.FieldSelector.Value"
                            android:hint="@string/transaction_wallet_placeholder"
                            tools:text="Techcombank" />
                    </LinearLayout>

                    <ImageView style="@style/Widget.App.FieldSelector.Chevron" />
                </LinearLayout>
            </LinearLayout>

            <include
                android:id="@+id/stateUnreadable"
                layout="@layout/view_state_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/actionBarReview"
        style="@style/Widget.App.BottomActionBar"
        android:paddingTop="@dimen/spacing_8"
        android:paddingBottom="@dimen/spacing_16">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmReceipt"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/receipt_confirm_save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddReceipt"
            style="@style/Widget.App.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="@string/receipt_add_more" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRescan"
            style="@style/Widget.App.Button.Tertiary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="@string/receipt_rescan" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManualEntry"
            style="@style/Widget.App.Button.Tertiary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/receipt_manual_entry"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
