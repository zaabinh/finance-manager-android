<?xml version="1.0" encoding="utf-8"?>
<!-- Card/Transaction 429:2230: surface (Pressed: bg/subtle), 1dp border/default, radius/medium -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface_secondary" />
            <stroke android:width="@dimen/divider_height" android:color="@color/divider_light" />
            <corners android:radius="@dimen/radius_input_button" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card_surface" />
            <stroke android:width="@dimen/divider_height" android:color="@color/divider_light" />
            <corners android:radius="@dimen/radius_input_button" />
        </shape>
    </item>
</selector>
