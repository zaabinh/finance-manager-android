<?xml version="1.0" encoding="utf-8"?>
<!-- Figma Budget Detail v2 676:8924 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app_canvas"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarBudgetDetail"
        style="@style/Widget.App.Toolbar.Back"
        app:title="@string/budget_detail_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_16"
            android:paddingTop="@dimen/spacing_8"
            android:paddingEnd="@dimen/spacing_16"
            android:paddingBottom="@dimen/spacing_16">

            <!-- Summary Card -->
            <LinearLayout
                style="@style/Widget.App.CardOutlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_20">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDetailCategoryName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.App.TitleSection"
                        tools:text="Ăn uống &amp; Cafe" />

                    <TextView
                        android:id="@+id/tvDetailPercentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.App.Label"
                        android:textColor="@color/text_secondary"
                        tools:text="65%" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDetailSpentAmount"
                    style="@style/Widget.App.TextView.Amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:textAppearance="@style/TextAppearance.App.AmountHero"
                    tools:text="3.245.000&#160;đ" />

                <TextView
                    android:id="@+id/tvDetailLimitAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:textAppearance="@style/TextAppearance.App.BodySecondary"
                    tools:text="Giới hạn tháng: 5.000.000&#160;đ" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressDetailBudget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_16"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp"
                    tools:progress="65" />

                <TextView
                    android:id="@+id/tvDetailStatusMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:textAppearance="@style/TextAppearance.App.BodySecondary"
                    tools:text="Còn lại 1.755.000&#160;đ trong ngân sách" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:layout_marginBottom="@dimen/spacing_8"
                android:text="@string/transaction_history_title"
                android:textAppearance="@style/TextAppearance.App.TitleSection" />

            <TextView
                android:id="@+id/tvBudgetTransactionsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/finance_budget_transactions_empty"
                android:textAppearance="@style/TextAppearance.App.BodySecondary"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBudgetTransactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_transaction" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        style="@style/Widget.App.BottomActionBar"
        android:orientation="horizontal"
        android:paddingTop="@dimen/spacing_8"
        android:paddingBottom="@dimen/spacing_16">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteBudget"
            style="@style/Widget.App.Button.Destructive"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_delete_budget" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditBudget"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_12"
            android:layout_weight="1"
            android:text="@string/btn_edit" />
    </LinearLayout>
</LinearLayout>
