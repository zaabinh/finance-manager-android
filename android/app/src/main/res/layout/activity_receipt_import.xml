<!-- Figma 04_TransactionQuickImport — v2 (concept) 658:6489; reading state 658:6551.
     Reading: tvImportFeedback = receipt_import_reading, groupImportOptions GONE, stateLoadingForm VISIBLE.
     Camera permission 658:6541 = dialog_confirm Regular. No camera/OCR implementation here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app_canvas"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarReceiptImport"
        style="@style/Widget.App.Toolbar.Back"
        app:title="@string/receipt_import_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_16"
            android:paddingTop="@dimen/spacing_8"
            android:paddingEnd="@dimen/spacing_16"
            android:paddingBottom="@dimen/spacing_16">

            <LinearLayout
                android:id="@+id/feedbackImport"
                style="@style/Widget.App.FeedbackInline.Info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:orientation="horizontal">

                <ImageView
                    style="@style/Widget.App.FeedbackInline.Icon"
                    android:src="@drawable/ic_info" />

                <TextView
                    android:id="@+id/tvImportFeedback"
                    style="@style/Widget.App.FeedbackInline.Message"
                    android:text="@string/receipt_import_experimental" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/groupImportOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    style="@style/Widget.App.CardOutlined"
                    android:layout_marginTop="@dimen/spacing_16"
                    android:padding="@dimen/divider_height">

                    <LinearLayout
                        android:id="@+id/optionCamera"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_list_option"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/selector_min_height"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/spacing_16"
                        android:paddingEnd="@dimen/spacing_16">

                        <ImageView
                            android:layout_width="@dimen/icon_size_default"
                            android:layout_height="@dimen/icon_size_default"
                            android:layout_marginEnd="@dimen/spacing_12"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_camera" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/receipt_import_camera"
                            android:textAppearance="@style/TextAppearance.App.BodyPrimary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/optionLibrary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_list_option"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/selector_min_height"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/spacing_16"
                        android:paddingEnd="@dimen/spacing_16">

                        <ImageView
                            android:layout_width="@dimen/icon_size_default"
                            android:layout_height="@dimen/icon_size_default"
                            android:layout_marginEnd="@dimen/spacing_12"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_image" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/receipt_import_library"
                            android:textAppearance="@style/TextAppearance.App.BodyPrimary" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvImportExplainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_16"
                    android:text="@string/receipt_import_explainer"
                    android:textAppearance="@style/TextAppearance.App.BodySecondary" />
            </LinearLayout>

            <include
                android:id="@+id/stateLoadingForm"
                layout="@layout/view_state_loading_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
