<?xml version="1.0" encoding="utf-8"?>
<!-- "Tạo ngân sách tháng": month + category rows; total is derived live (sum of rows), never entered. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app_canvas"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarMonthlyBudgetForm"
        style="@style/Widget.App.Toolbar.Back"
        app:title="@string/monthly_budget_create_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_16"
            android:paddingTop="@dimen/spacing_8"
            android:paddingEnd="@dimen/spacing_16"
            android:paddingBottom="@dimen/spacing_16">

            <LinearLayout
                android:id="@+id/fieldMonthlyBudgetPeriod"
                style="@style/Widget.App.FieldSelector"
                android:layout_marginTop="@dimen/spacing_8">

                <ImageView
                    style="@style/Widget.App.FieldSelector.Icon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_calendar" />

                <LinearLayout style="@style/Widget.App.FieldSelector.Content">

                    <TextView
                        style="@style/Widget.App.FieldSelector.Label"
                        android:text="@string/budget_period_label" />

                    <TextView
                        android:id="@+id/tvMonthlyBudgetPeriodValue"
                        style="@style/Widget.App.FieldSelector.Value"
                        tools:text="Tháng 11/2026" />
                </LinearLayout>

                <ImageView
                    style="@style/Widget.App.FieldSelector.Chevron"
                    android:contentDescription="@null" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:text="@string/monthly_budget_categories_title"
                android:textAppearance="@style/TextAppearance.App.TitleSection" />

            <LinearLayout
                android:id="@+id/containerBudgetRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddBudgetRow"
                style="@style/Widget.App.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:text="@string/monthly_budget_add_category"
                app:icon="@drawable/ic_plus" />

            <TextView
                android:id="@+id/tvMonthlyBudgetTotal"
                style="@style/Widget.App.TextView.Amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.App.TitleSection"
                tools:text="Tổng ngân sách tháng: 5.000.000 đ" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:text="@string/monthly_budget_total_hint"
                android:textAppearance="@style/TextAppearance.App.Caption" />

            <include layout="@layout/view_budget_shortfall" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout style="@style/Widget.App.BottomActionBar">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveMonthlyBudget"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_create_budget" />
    </LinearLayout>
</LinearLayout>
