<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app_canvas"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:fitsSystemWindows="true">

    <!-- Container chính: Căn giữa form khi xoay ngang / màn hình to -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_24"
        android:paddingVertical="@dimen/spacing_16">

        <!-- Form chính: Giới hạn maxWidth để giao diện cân đối khi xoay ngang -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="440dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Header Logo -->
            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/spacing_12"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_micro_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.App.TitlePage" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:text="@string/app_slogan"
                android:textAppearance="@style/TextAppearance.App.BodySecondary" />

            <!-- Registration Form Fields -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:orientation="vertical">

                <!-- Field 1: Username -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_username"
                    android:textAppearance="@style/TextAppearance.App.TitleSection" />

                <EditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:autofillHints="username"
                    android:background="@drawable/bg_input_field"
                    android:drawableStart="@drawable/ic_person"
                    android:drawablePadding="@dimen/spacing_12"
                    android:hint="@string/hint_username"
                    android:inputType="textPersonName"
                    android:paddingHorizontal="@dimen/spacing_16"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_disabled"
                    android:textSize="@dimen/text_size_body_primary" />

                <!-- Field 2: Email -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:text="@string/label_email"
                    android:textAppearance="@style/TextAppearance.App.TitleSection" />

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:autofillHints="emailAddress"
                    android:background="@drawable/bg_input_field"
                    android:drawableStart="@drawable/ic_email"
                    android:drawablePadding="@dimen/spacing_12"
                    android:hint="@string/hint_email"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="@dimen/spacing_16"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_disabled"
                    android:textSize="@dimen/text_size_body_primary" />

                <!-- Field 3: Password -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:text="@string/label_password"
                    android:textAppearance="@style/TextAppearance.App.TitleSection" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:background="@drawable/bg_input_field">

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toStartOf="@+id/ivTogglePassword"
                        android:autofillHints="newPassword"
                        android:background="@null"
                        android:drawableStart="@drawable/ic_lock"
                        android:drawablePadding="@dimen/spacing_12"
                        android:hint="@string/hint_password"
                        android:inputType="textPassword"
                        android:paddingHorizontal="@dimen/spacing_16"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_disabled"
                        android:textSize="@dimen/text_size_body_primary" />

                    <ImageView
                        android:id="@+id/ivTogglePassword"
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/label_password"
                        android:padding="12dp"
                        android:src="@drawable/ic_eye_close" />
                </RelativeLayout>

                <!-- Field 4: Confirm Password -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:text="@string/label_confirm_password"
                    android:textAppearance="@style/TextAppearance.App.TitleSection" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:background="@drawable/bg_input_field">

                    <EditText
                        android:id="@+id/etConfirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toStartOf="@+id/ivToggleConfirmPassword"
                        android:autofillHints="newPassword"
                        android:background="@null"
                        android:drawableStart="@drawable/ic_lock"
                        android:drawablePadding="@dimen/spacing_12"
                        android:hint="@string/hint_password"
                        android:inputType="textPassword"
                        android:paddingHorizontal="@dimen/spacing_16"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_disabled"
                        android:textSize="@dimen/text_size_body_primary" />

                    <ImageView
                        android:id="@+id/ivToggleConfirmPassword"
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/label_confirm_password"
                        android:padding="12dp"
                        android:src="@drawable/ic_eye_close" />
                </RelativeLayout>

                <!-- Checkbox Terms & Policies -->
                <CheckBox
                    android:id="@+id/cbTerms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:buttonTint="@color/color_primary"
                    android:text="@string/checkbox_terms_policies"
                    android:textAppearance="@style/TextAppearance.App.BodySecondary" />

                <!-- Register Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/spacing_16"
                    android:background="@drawable/bg_button_primary"
                    android:text="@string/btn_register"
                    android:textAllCaps="false"
                    android:textColor="@color/text_on_primary"
                    android:textSize="@dimen/text_size_title_section"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Flexible Spacer: Đẩy link Đăng nhập xuống đáy nếu màn hình cao -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Bottom Link to Login -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_8">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prompt_already_have_account"
                android:textAppearance="@style/TextAppearance.App.BodyPrimary" />

            <Space
                android:layout_width="@dimen/spacing_4"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvSignIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/spacing_4"
                android:text="@string/action_sign_in"
                android:textAppearance="@style/TextAppearance.App.Button" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>