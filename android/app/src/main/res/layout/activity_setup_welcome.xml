<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 02_SetupWelcome — v2 (679:10557) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app_canvas"
    android:fitsSystemWindows="true">

    <!-- Decoration/Landscape (717:10398): low-contrast band behind the lower half -->
    <ImageView
        android:id="@+id/ivLandscape"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/bg_setup_landscape"
        app:layout_constraintBottom_toTopOf="@id/footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/llCenterContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_24"
            android:paddingTop="88dp"
            android:paddingEnd="@dimen/spacing_24"
            android:paddingBottom="@dimen/spacing_16">

            <!-- Brand/Logo/Mark (625:1950) -->
            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_logo" />

            <TextView
                android:id="@+id/tvBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:text="@string/setup_welcome_brand"
                android:textColor="@color/text_primary"
                android:textSize="44sp" />

            <!-- Slogan: styled string bolds each "Đồng" in brand green -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:gravity="center"
                android:text="@string/setup_welcome_title"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:gravity="center"
                android:lineSpacingExtra="2sp"
                android:text="@string/setup_welcome_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>

    <!-- Footer (fixed CTA) 718:12399 -->
    <FrameLayout
        android:id="@+id/footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacing_24"
        android:paddingTop="@dimen/spacing_8"
        android:paddingEnd="@dimen/spacing_24"
        android:paddingBottom="@dimen/spacing_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_start" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
