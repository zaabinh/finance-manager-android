<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen form built from the Sheet/Category field structure (form_category_fields). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app_canvas"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarForm"
        style="@style/Widget.App.Toolbar.Back"
        app:title="@string/category_edit_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_16">

            <include layout="@layout/form_category_fields" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:labelFor="@id/etCategorySortOrder"
                android:text="@string/category_sort_label"
                android:textAppearance="@style/TextAppearance.App.Label" />

            <EditText
                android:id="@+id/etCategorySortOrder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:background="@drawable/bg_input_field"
                android:hint="0"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="10"
                android:minHeight="@dimen/input_min_height"
                android:paddingHorizontal="@dimen/spacing_12"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.App.BodyPrimary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_target_min"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStatusLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/status_active"
                    android:textAppearance="@style/TextAppearance.App.BodyPrimary" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet_action_divider"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_16">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteCategory"
            style="@style/Widget.App.Button.Outline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_delete_category" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveChanges"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_12"
            android:text="@string/btn_save_changes" />
    </LinearLayout>
</LinearLayout>
