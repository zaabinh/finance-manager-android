<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app_canvas"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacing_24"
        android:paddingEnd="@dimen/spacing_24"
        android:paddingTop="@dimen/spacing_16"
        android:paddingBottom="@dimen/spacing_16">

        <LinearLayout
            android:id="@+id/llFormContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="440dp">

            <!-- Top Header Logo -->
            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/spacing_12"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_micro_logo" />

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:importantForAccessibility="no"
                android:text="@string/forgot_password_title"
                android:textAppearance="@style/TextAppearance.App.TitlePage" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:text="@string/verify_email_subtitle"
                android:textAppearance="@style/TextAppearance.App.BodySecondary" />

            <!-- Form Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:orientation="vertical">

                <!-- Field: Email -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_email"
                    android:textAppearance="@style/TextAppearance.App.TitleSection" />

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:autofillHints="emailAddress"
                    android:background="@drawable/bg_input_field"
                    android:drawableStart="@drawable/ic_email"
                    android:drawablePadding="@dimen/spacing_12"
                    android:hint="@string/hint_email"
                    android:inputType="textEmailAddress"
                    android:paddingStart="@dimen/spacing_16"
                    android:paddingEnd="@dimen/spacing_16"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="@dimen/text_size_body_primary" />

                <!-- Send Button Container -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_20">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnSend"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_button_primary"
                        android:text="@string/btn_send"
                        android:textAllCaps="false"
                        android:textColor="@color/text_on_primary"
                        android:textSize="@dimen/text_size_title_section"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_max="320dp" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Back to Login Link -->
                <TextView
                    android:id="@+id/tvBackToLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/spacing_16"
                    android:background="?attr/selectableItemBackground"
                    android:padding="@dimen/spacing_8"
                    android:text="@string/action_back_to_login"
                    android:textAppearance="@style/TextAppearance.App.Button" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
