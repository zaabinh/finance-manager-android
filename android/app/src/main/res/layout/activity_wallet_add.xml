<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app_canvas"
    android:fitsSystemWindows="true">

    <!-- Header Toolbar -->
    <RelativeLayout
        android:id="@+id/rlHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_16"
        android:paddingTop="@dimen/spacing_16"
        android:paddingBottom="@dimen/spacing_12"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/icon_back_size"
            android:layout_height="@dimen/icon_back_size"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="4dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/wallet_add_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_title_section"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Main Form ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/spacing_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rlHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_16">

            <!-- Field 1: Tên ví -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:text="@string/wallet_name_label"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etWalletName"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/spacing_8"
                android:background="@drawable/bg_currency_box"
                android:hint="@string/wallet_name_hint"
                android:inputType="textCapWords"
                android:paddingHorizontal="@dimen/spacing_16"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_disabled"
                android:textSize="@dimen/text_size_body_primary" />

            <!-- Field 2: Loại ví -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_20"
                android:text="@string/wallet_type_label"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold" />

            <!-- Type Pills Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pillCash"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="@dimen/spacing_4"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_unselected"
                    android:gravity="center"
                    android:text="@string/wallet_type_cash"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_label" />

                <TextView
                    android:id="@+id/pillBank"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="@dimen/spacing_4"
                    android:layout_marginEnd="@dimen/spacing_4"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_selected"
                    android:gravity="center"
                    android:text="@string/wallet_type_bank"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_label"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pillEWallet"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="@dimen/spacing_4"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_unselected"
                    android:gravity="center"
                    android:text="@string/wallet_type_ewallet"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_label" />
            </LinearLayout>

            <!-- Type Pills Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pillSavings"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_pill_unselected"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/spacing_16"
                    android:text="@string/wallet_type_savings"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_label" />
            </LinearLayout>

            <!-- Field 3: Ngân hàng / Nhà cung cấp -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_20"
                android:text="@string/wallet_provider_label"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold" />

            <RelativeLayout
                android:id="@+id/btnSelectProvider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/spacing_8"
                android:background="@drawable/bg_currency_box"
                android:paddingHorizontal="@dimen/spacing_16">

                <TextView
                    android:id="@+id/tvSelectedProvider"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="@string/wallet_provider_hint"
                    android:textColor="@color/text_disabled"
                    android:textSize="@dimen/text_size_body_primary" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/text_secondary" />
            </RelativeLayout>

            <!-- Field 4: Số dư hiện tại + Currency Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_20"
                android:orientation="horizontal">

                <!-- Balance Input -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_8"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wallet_balance_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:background="@drawable/bg_currency_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/spacing_12">

                        <EditText
                            android:id="@+id/etBalance"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="0"
                            android:inputType="number"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_body_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="đ"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_body_primary" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Currency Selector -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_8"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <View
                        android:layout_width="wrap_content"
                        android:layout_height="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:background="@drawable/bg_currency_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/spacing_12">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_bank_card"
                            app:tint="@color/text_secondary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_8"
                            android:layout_weight="1"
                            android:text="Tiền tệ\nVND"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Field 5: Ghi chú -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_20"
                android:text="@string/wallet_note_label"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNote"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/spacing_8"
                android:background="@drawable/bg_currency_box"
                android:hint="@string/wallet_note_hint"
                android:inputType="text"
                android:paddingHorizontal="@dimen/spacing_16"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_disabled"
                android:textSize="@dimen/text_size_body_primary" />

            <!-- Bottom Action Buttons: Create & Cancel -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCreateWallet"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_32"
                android:background="@drawable/bg_button_primary"
                android:text="@string/btn_create_wallet"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_button"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCancel"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_12"
                android:background="@drawable/bg_button_outline"
                android:text="@string/btn_cancel"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_button"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>