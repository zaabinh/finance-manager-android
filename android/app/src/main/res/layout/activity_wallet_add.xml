<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen form built from the Sheet/Wallet field structure (form_wallet_fields). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app_canvas"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarForm"
        style="@style/Widget.App.Toolbar.Back"
        app:title="@string/wallet_add_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_16">

            <include layout="@layout/form_wallet_fields" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:labelFor="@id/etWalletSortOrder"
                android:text="@string/wallet_sort_order"
                android:textAppearance="@style/TextAppearance.App.Label" />

            <EditText
                android:id="@+id/etWalletSortOrder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:background="@drawable/bg_input_field"
                android:hint="0"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="9"
                android:minHeight="@dimen/input_min_height"
                android:paddingHorizontal="@dimen/spacing_12"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.App.BodyPrimary" />

            <CheckBox
                android:id="@+id/cbWalletIncludeAssets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:checked="true"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/wallet_include_assets" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet_action_divider"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_16">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.App.Button.Outline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_cancel" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateWallet"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_12"
            android:text="@string/btn_create_wallet" />
    </LinearLayout>
</LinearLayout>
