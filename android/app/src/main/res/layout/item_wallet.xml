<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_12"
    android:background="@drawable/bg_card_white"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_16">

    <!-- Icon Box -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_chip"
        android:padding="10dp">

        <ImageView
            android:id="@+id/ivWalletIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:src="@drawable/ic_bank_card"
            app:tint="@color/color_primary" />
    </FrameLayout>

    <!-- Name and Subtitle -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvWalletName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Techcombank"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_body_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWalletSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2"
            android:text="Tài khoản thanh toán"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_caption" />
    </LinearLayout>

    <!-- Amount -->
    <TextView
        android:id="@+id/tvWalletBalance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_8"
        android:text="15.736.000 đ"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_size_body_primary"
        android:textStyle="bold" />

</LinearLayout>