<?xml version="1.0" encoding="utf-8"?>
<!-- Shared by Sheet/Category 718:11596 and the category create/edit screens:
     Type (Control/Segmented; the Transfer segment is hidden by the include), Name, Icon grid (Control/IconChoice). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include layout="@layout/view_transaction_type_segmented" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:labelFor="@id/etCategoryName"
        android:text="@string/category_name_label"
        android:textAppearance="@style/TextAppearance.App.Label" />

    <EditText
        android:id="@+id/etCategoryName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4"
        android:autofillHints="name"
        android:background="@drawable/bg_input_field"
        android:hint="@string/category_name_example"
        android:inputType="textCapSentences"
        android:maxLength="100"
        android:minHeight="@dimen/input_min_height"
        android:paddingHorizontal="@dimen/spacing_12"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.App.BodyPrimary"
        android:textColorHint="@color/text_hint" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:text="@string/category_icon_label"
        android:textAppearance="@style/TextAppearance.App.Label" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvIconPicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="5" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:text="@string/category_color_title"
        android:textAppearance="@style/TextAppearance.App.Label" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvColorPicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="4" />
</LinearLayout>
