<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app_canvas"
    android:fitsSystemWindows="true">

    <!-- Main Form Container -->
    <LinearLayout
        android:id="@+id/llFormContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_24"
        android:paddingTop="@dimen/spacing_16"
        android:paddingBottom="@dimen/spacing_8"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/llBottomButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="440dp">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/llHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@null"
                android:padding="@dimen/spacing_12"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_8"
                android:layout_weight="1"
                android:text="@string/setup_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_amount_medium"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Progress Indicator -->
        <LinearLayout
            android:id="@+id/llProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bước 2/3"
                android:textColor="@color/color_primary"
                android:textSize="@dimen/text_size_body_secondary"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/progress_bar_height"
                android:layout_marginTop="@dimen/spacing_8"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_progress_active" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/progress_bar_gap"
                    android:layout_weight="1"
                    android:background="@drawable/bg_progress_active" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/progress_bar_gap"
                    android:layout_weight="1"
                    android:background="@drawable/bg_progress_track" />

            </LinearLayout>

        </LinearLayout>

        <!-- Scrollable Content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/spacing_20"
            android:layout_weight="1"
            android:fillViewport="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/spacing_24">

                <!-- Title -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_notif_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_amount_medium"
                    android:textStyle="bold" />

                <!-- Subtitle -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:lineSpacingExtra="@dimen/spacing_4"
                    android:text="@string/setup_notif_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_body_primary" />

                <!-- Notification Settings Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_20"
                    android:background="@drawable/bg_card_white"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <!-- Row 1: Enable Notifications -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_container_size"
                            android:layout_height="@dimen/icon_container_size"
                            android:background="@drawable/bg_icon_container_green"
                            android:contentDescription="@null"
                            android:padding="@dimen/spacing_8"
                            android:src="@drawable/ic_bell"
                            app:tint="@color/color_primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_12"
                            android:layout_marginEnd="@dimen/spacing_8"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/notif_enable_title"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_size_title_section"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_4"
                                android:text="@string/notif_enable_desc"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_size_label" />

                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchEnableNotif"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:minWidth="48dp"
                            app:useMaterialThemeColors="true" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_height"
                        android:layout_marginVertical="@dimen/spacing_12"
                        android:background="@color/divider_light" />

                    <!-- Row 2: Daily Reminder -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/spacing_8"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/notif_remind_title"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_size_title_section"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_4"
                                android:text="@string/notif_remind_desc"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_size_label" />

                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchDailyReminder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:minWidth="48dp"
                            app:useMaterialThemeColors="true" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_height"
                        android:layout_marginVertical="@dimen/spacing_12"
                        android:background="@color/divider_light" />

                    <!-- Row 3: Reminder Time -->
                    <LinearLayout
                        android:id="@+id/llTimePickerRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/spacing_4">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/notif_time_label"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_title_section" />

                        <TextView
                            android:id="@+id/tvReminderTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="20:00"
                            android:textColor="@color/color_primary"
                            android:textSize="@dimen/text_size_title_section"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="@dimen/icon_small_size"
                            android:layout_height="@dimen/icon_small_size"
                            android:layout_marginStart="@dimen/spacing_8"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/color_primary" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_height"
                        android:layout_marginVertical="@dimen/spacing_12"
                        android:background="@color/divider_light" />

                    <!-- Row 4: Budget Alert -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/spacing_8"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/notif_alert_title"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_size_title_section"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_4"
                                android:text="@string/notif_alert_desc"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_size_label" />

                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchBudgetAlert"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:minWidth="48dp"
                            app:useMaterialThemeColors="true" />

                    </LinearLayout>

                    <!-- Row 5: Budget Alert Threshold -->
                    <LinearLayout
                        android:id="@+id/rowBudgetThreshold"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/budget_alert_threshold"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_body_primary" />

                        <TextView
                            android:id="@+id/tvBudgetThreshold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="80%"
                            android:textColor="@color/color_primary"
                            android:textSize="@dimen/text_size_body_primary"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Disclaimer -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_16"
                    android:lineSpacingExtra="@dimen/spacing_4"
                    android:text="@string/notif_permission_note"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_label" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <!-- Bottom Actions -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/llBottomButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_app_canvas"
        android:paddingHorizontal="@dimen/spacing_24"
        android:paddingTop="@dimen/spacing_8"
        android:paddingBottom="@dimen/spacing_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnContinue"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_large"
            android:background="@drawable/bg_button_primary"
            android:minHeight="48dp"
            android:text="@string/btn_continue"
            android:textAllCaps="false"
            android:textColor="@color/text_on_primary"
            android:textSize="@dimen/text_size_button"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_max="320dp" />

        <TextView
            android:id="@+id/tvSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="40dp"
            android:gravity="center"
            android:paddingHorizontal="@dimen/spacing_16"
            android:text="@string/btn_later"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_body_primary"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/btnContinue"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
