<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/speedDialRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <!-- Dark Scrim Backdrop Overlay -->
    <View
        android:id="@+id/speedDialScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true" />

    <!-- Popup Options Container anchored at bottom center -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Item 1: Nhập thủ công (Upper) -->
        <LinearLayout
            android:id="@+id/btnManualInput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_fab_sub_item"
                android:elevation="6dp"
                android:padding="12dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_pencil"
                    app:tint="@color/color_primary" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_label_pill"
                android:elevation="4dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="Nhập thủ công"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Item 2: Quét hoá đơn -->
        <LinearLayout
            android:id="@+id/btnOcrScan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_fab_sub_item"
                android:elevation="6dp"
                android:padding="12dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/color_primary" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_label_pill"
                android:elevation="4dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="Quét hoá đơn"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Item 3: Giọng nói -->
        <LinearLayout
            android:id="@+id/btnVoiceInput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_fab_sub_item"
                android:elevation="6dp"
                android:padding="12dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_mic"
                    app:tint="@color/color_primary" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_label_pill"
                android:elevation="4dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="@string/quick_action_voice"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Expanded Close FAB Button (X) -->
        <FrameLayout
            android:id="@+id/btnFabClose"
            android:layout_width="@dimen/fab_size"
            android:layout_height="@dimen/fab_size"
            android:background="@drawable/bg_fab_circle"
            android:elevation="6dp">

            <ImageView
                android:layout_width="@dimen/icon_fab_size"
                android:layout_height="@dimen/icon_fab_size"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_close"
                app:tint="@color/text_on_primary" />
        </FrameLayout>

    </LinearLayout>

</FrameLayout>