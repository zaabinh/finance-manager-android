<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app_canvas"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacing_16"
        android:paddingEnd="@dimen/spacing_16"
        android:paddingTop="@dimen/spacing_16"
        android:paddingBottom="@dimen/spacing_16">

        <LinearLayout
            android:id="@+id/llFormContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="440dp">

            <!-- Top Header Logo -->
            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/spacing_12"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_micro_logo" />

            <!-- Title & Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:importantForAccessibility="no"
                android:text="@string/verify_email_title"
                android:textAppearance="@style/TextAppearance.App.TitlePage" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:text="@string/verify_email_subtitle"
                android:textAppearance="@style/TextAppearance.App.BodySecondary" />

            <!-- 6 OTP Boxes -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:gravity="center"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etOtp1"
                    android:layout_width="44dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:autofillHints="oneTimeCode"
                    android:background="@drawable/bg_otp_box"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etOtp2"
                    android:layout_width="44dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:autofillHints="oneTimeCode"
                    android:background="@drawable/bg_otp_box"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etOtp3"
                    android:layout_width="44dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:autofillHints="oneTimeCode"
                    android:background="@drawable/bg_otp_box"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etOtp4"
                    android:layout_width="44dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:autofillHints="oneTimeCode"
                    android:background="@drawable/bg_otp_box"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etOtp5"
                    android:layout_width="44dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:autofillHints="oneTimeCode"
                    android:background="@drawable/bg_otp_box"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etOtp6"
                    android:layout_width="44dp"
                    android:layout_height="52dp"
                    android:autofillHints="oneTimeCode"
                    android:background="@drawable/bg_otp_box"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Verify Button Container -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnVerify"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_button_primary"
                    android:text="@string/btn_verify"
                    android:textAllCaps="false"
                    android:textColor="@color/text_on_primary"
                    android:textSize="@dimen/text_size_title_section"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_max="320dp" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Resend OTP Countdown -->
            <TextView
                android:id="@+id/tvResendOtp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_20"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/spacing_8"
                android:text="@string/resend_otp_countdown"
                android:textColor="@color/color_primary"
                android:textAppearance="@style/TextAppearance.App.Button" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
