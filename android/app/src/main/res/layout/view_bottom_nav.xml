<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNavContainer"
    android:layout_width="match_parent"
    android:layout_height="@dimen/nav_bar_height"
    android:background="@color/bg_card_surface">

    <!-- Top Divider Line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="top"
        android:background="@color/divider_light" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Item 1: Home -->
        <LinearLayout
            android:id="@+id/containerNavHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navHome"
                android:layout_width="44dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_nav_indicator"
                android:contentDescription="@string/nav_home_label"
                android:paddingHorizontal="10dp"
                android:paddingVertical="2dp"
                android:src="@drawable/ic_nav_house"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/lblNavHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_home_label"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption" />

        </LinearLayout>

        <!-- Item 2: Transaction / Report -->
        <LinearLayout
            android:id="@+id/containerNavReport"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navReport"
                android:layout_width="44dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_nav_indicator"
                android:contentDescription="@string/nav_report_label"
                android:paddingHorizontal="10dp"
                android:paddingVertical="2dp"
                android:src="@drawable/ic_nav_history"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/lblNavReport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_report_label"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption" />

        </LinearLayout>

        <!-- Placeholder for Center FAB -->
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <!-- Item 3: Budget -->
        <LinearLayout
            android:id="@+id/containerNavBudget"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navBudget"
                android:layout_width="44dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_nav_indicator"
                android:contentDescription="@string/nav_budget_label"
                android:paddingHorizontal="10dp"
                android:paddingVertical="2dp"
                android:src="@drawable/ic_nav_layers"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/lblNavBudget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_budget_label"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption" />

        </LinearLayout>

        <!-- Item 4: Setting -->
        <LinearLayout
            android:id="@+id/containerNavSetting"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navSetting"
                android:layout_width="44dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_nav_indicator"
                android:contentDescription="@string/nav_setting_label"
                android:paddingHorizontal="10dp"
                android:paddingVertical="2dp"
                android:src="@drawable/ic_nav_settings"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/lblNavSetting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_setting_label"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption" />

        </LinearLayout>

    </LinearLayout>

    <!-- Floating Action Button in Middle -->
    <FrameLayout
        android:id="@+id/fabAddTransaction"
        android:layout_width="@dimen/fab_size"
        android:layout_height="@dimen/fab_size"
        android:layout_gravity="center"
        android:background="@drawable/bg_fab_circle"
        android:elevation="4dp">

        <ImageView
            android:layout_width="@dimen/icon_fab_size"
            android:layout_height="@dimen/icon_fab_size"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_plus"
            app:tint="@color/text_on_primary" />
    </FrameLayout>

</FrameLayout>