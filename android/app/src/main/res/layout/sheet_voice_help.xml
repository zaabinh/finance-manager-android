<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_20"
    android:paddingEnd="@dimen/spacing_20"
    android:paddingBottom="@dimen/spacing_24">

    <!-- Bottom Sheet Header Handle -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/sheet_handle_area_height">

        <View
            android:layout_width="@dimen/sheet_handle_width"
            android:layout_height="@dimen/sheet_handle_height"
            android:layout_gravity="center"
            android:background="@drawable/bg_sheet_handle" />
    </FrameLayout>

    <!-- Title Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_target_min"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/voice_help_title"
            android:textAppearance="@style/TextAppearance.App.TitleSection" />

        <ImageButton
            android:id="@+id/btnHelpClose"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_close"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:maxHeight="420dp"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section 1: Formula -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/voice_help_formula_title"
                android:textAppearance="@style/TextAppearance.App.BodyPrimary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:background="@drawable/bg_chip"
                android:padding="@dimen/spacing_12"
                android:text="@string/voice_help_formula_desc"
                android:textAppearance="@style/TextAppearance.App.BodyPrimary"
                android:textColor="@color/color_primary"
                android:textStyle="bold" />

            <!-- Section 2: Real Examples -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:text="@string/voice_help_examples_title"
                android:textAppearance="@style/TextAppearance.App.BodyPrimary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:lineSpacingExtra="4dp"
                android:text="@string/voice_help_example_item_1"
                android:textAppearance="@style/TextAppearance.App.BodySecondary"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:lineSpacingExtra="4dp"
                android:text="@string/voice_help_example_item_2"
                android:textAppearance="@style/TextAppearance.App.BodySecondary"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:lineSpacingExtra="4dp"
                android:text="@string/voice_help_example_item_3"
                android:textAppearance="@style/TextAppearance.App.BodySecondary"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:lineSpacingExtra="4dp"
                android:text="@string/voice_help_example_item_4"
                android:textAppearance="@style/TextAppearance.App.BodySecondary"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:lineSpacingExtra="4dp"
                android:text="@string/voice_help_example_item_5"
                android:textAppearance="@style/TextAppearance.App.BodySecondary"
                android:textColor="@color/text_primary" />

            <!-- Section 3: Slang -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:text="@string/voice_help_slang_title"
                android:textAppearance="@style/TextAppearance.App.BodyPrimary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:lineSpacingExtra="4dp"
                android:text="@string/voice_help_slang_desc"
                android:textAppearance="@style/TextAppearance.App.BodySecondary"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <Button
        android:id="@+id/btnHelpGotIt"
        style="@style/Widget.App.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_20"
        android:text="@string/voice_help_btn_got_it" />
</LinearLayout>
