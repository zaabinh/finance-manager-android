<?xml version="1.0" encoding="utf-8"?>
<!-- Shown on 409 BUDGET_EXCEEDS_AVAILABLE_BALANCE; the form keeps its input. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/panelShortfall"
    style="@style/Widget.App.CardOutlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_16"
    android:orientation="vertical"
    android:padding="@dimen/spacing_16"
    android:visibility="gone"
    tools:visibility="visible">

    <TextView
        android:id="@+id/tvShortfall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:textAppearance="@style/TextAppearance.App.BodySecondary"
        android:textColor="@color/status_error"
        tools:text="Ngân sách cần chi vượt số dư khả dụng 30.000 đ." />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTransferFromSavings"
        style="@style/Widget.App.Button.Outline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:text="@string/budget_transfer_from_savings" />
</LinearLayout>
