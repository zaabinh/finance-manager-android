<?xml version="1.0" encoding="utf-8"?>
<!-- Figma Dialog/Confirm 628:2734. Content for a Dialog / MaterialAlertDialogBuilder.setView().
     Destructive (delete, 658:5645): btnDialogConfirmDestructive. Regular (camera permission,
     658:6541): hide it and show btnDialogConfirm with receipt_* strings. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dialogConfirm"
    android:layout_width="@dimen/dialog_width"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:elevation="@dimen/spacing_8"
    android:orientation="vertical"
    android:padding="@dimen/spacing_24">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="@string/transaction_delete_title"
        android:textAppearance="@style/TextAppearance.App.TitlePage" />

    <TextView
        android:id="@+id/tvDialogBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:textAppearance="@style/TextAppearance.App.BodyPrimary"
        android:textColor="@color/text_secondary"
        tools:text="Giao dịch −95.000&#160;đ lúc 15:45 ngày 26/10/2026 sẽ bị xóa và số dư Techcombank được tính lại. Không thể hoàn tác." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogCancel"
            style="@style/Widget.App.Button.Tertiary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogConfirmDestructive"
            style="@style/Widget.App.Button.Destructive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_8"
            android:text="@string/btn_delete" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogConfirm"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_8"
            android:visibility="gone"
            tools:text="@string/action_allow" />
    </LinearLayout>
</LinearLayout>
