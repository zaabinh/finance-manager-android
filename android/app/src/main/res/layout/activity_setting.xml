<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true">

    <!-- Scrollable Setting Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Tiêu đề -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:text="Cài đặt"
                android:textColor="#26332B"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Thẻ hồ sơ: nhấn để chỉnh sửa -->
            <LinearLayout
                android:id="@+id/layoutProfile"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_white"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_avatar"
                    android:gravity="center"
                    android:text="MA"
                    android:textColor="#216B45"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProfileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nguyễn Minh Anh"
                        android:textColor="#202A24"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvProfileEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="minh.anh@example.com"
                        android:textColor="#7B827D"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Thành viên Premium"
                        android:textColor="#7B827D"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnEditProfile"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Chỉnh sửa hồ sơ"
                    android:src="@drawable/ic_edit_gray" />
            </LinearLayout>

            <!-- Nhóm cài đặt chung -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical">

                <!-- Đơn vị tiền tệ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_currency"
                        android:drawablePadding="12dp"
                        android:gravity="center_vertical"
                        android:text="Đơn vị tiền tệ"
                        android:textColor="#202A24"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VND (₫)  ›"
                        android:textColor="#7B827D"
                        android:textSize="12sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E8ECE9" />

                <!-- Múi giờ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_globe"
                        android:drawablePadding="12dp"
                        android:gravity="center_vertical"
                        android:text="Múi giờ"
                        android:textColor="#202A24"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hanoi GMT+7  ›"
                        android:textColor="#7B827D"
                        android:textSize="12sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E8ECE9" />

                <!-- Cấu hình thông báo -->
                <TextView
                    android:id="@+id/rowNotification"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_notification"
                    android:drawableEnd="@drawable/ic_chevron_right"
                    android:drawablePadding="12dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:text="Cấu hình thông báo"
                    android:textColor="#202A24"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Nhóm quản lý -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical">

                <!-- Quản lý Ví -->
                <TextView
                    android:id="@+id/rowWallets"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_wallet"
                    android:drawablePadding="12dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:text="Quản lý Ví (Wallets)"
                    android:textColor="#202A24"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E8ECE9" />

                <!-- Quản lý Danh mục -->
                <TextView
                    android:id="@+id/rowCategories"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_category"
                    android:drawablePadding="12dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:text="Quản lý Danh mục"
                    android:textColor="#202A24"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E8ECE9" />

                <!-- Bảo mật & Tài khoản -->
                <TextView
                    android:id="@+id/rowSecurity"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_security"
                    android:drawablePadding="12dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:text="Bảo mật &amp; Tài khoản"
                    android:textColor="#202A24"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar (Được đồng bộ từ màn hình Home) -->
    <FrameLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_bar_height"
        android:background="@color/bg_card_surface"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Item 1: Home (Chuyển về màu xám vì đang ở Setting) -->
            <ImageView
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/app_name"
                android:padding="@dimen/spacing_12"
                android:src="@drawable/ic_home"
                app:tint="@color/text_secondary" />

            <!-- Item 2: Report -->
            <ImageView
                android:id="@+id/navReport"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="@dimen/spacing_12"
                android:src="@drawable/ic_report"
                app:tint="@color/text_secondary" />

            <!-- Placeholder for Center FAB -->
            <View
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <!-- Item 4: Wallet -->
            <ImageView
                android:id="@+id/navWallet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="@dimen/spacing_12"
                android:src="@drawable/ic_wallet"
                app:tint="@color/text_secondary" />

            <!-- Item 5: Menu / Setting (Sáng màu chủ đạo vì đang đứng ở Setting) -->
            <ImageView
                android:id="@+id/navSetting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="@dimen/spacing_12"
                android:src="@drawable/ic_menu"
                app:tint="@color/color_primary" />
        </LinearLayout>

        <!-- Floating Action Button in Middle -->
        <FrameLayout
            android:id="@+id/fabAddTransaction"
            android:layout_width="@dimen/fab_size"
            android:layout_height="@dimen/fab_size"
            android:layout_gravity="center"
            android:background="@drawable/bg_fab_circle"
            android:elevation="4dp">

            <ImageView
                android:layout_width="@dimen/icon_fab_size"
                android:layout_height="@dimen/icon_fab_size"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_plus"
                app:tint="@color/text_on_primary" />
        </FrameLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>