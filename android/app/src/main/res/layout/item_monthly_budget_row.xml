<?xml version="1.0" encoding="utf-8"?>
<!-- One category line of the monthly budget create form. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_8"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tvRowCategory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.App.BodyPrimary"
        tools:text="Ăn uống" />

    <EditText
        android:id="@+id/etRowLimit"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_8"
        android:autofillHints="none"
        android:gravity="end"
        android:hint="@string/monthly_budget_limit_hint"
        android:imeOptions="actionDone"
        android:inputType="number"
        android:maxLength="15"
        android:minHeight="48dp"
        tools:text="3000000" />

    <ImageButton
        android:id="@+id/btnRemoveRow"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/monthly_budget_remove_row"
        android:src="@drawable/ic_close"
        app:tint="@color/text_secondary" />
</LinearLayout>
