<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_8"
    android:background="@drawable/bg_card_white"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_16">

    <!-- Icon -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_expense_card"
        android:padding="10dp">

        <ImageView
            android:id="@+id/ivTxnIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:src="@drawable/ic_coffee"
            app:tint="@color/status_error" />
    </FrameLayout>

    <!-- Title and Subtitle -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTxnTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Highlands Coffee"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_body_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTxnSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2"
            android:text="Techcombank • Hôm qua, 15:45"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_caption" />
    </LinearLayout>

    <!-- Amount -->
    <TextView
        android:id="@+id/tvTxnAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_8"
        android:text="-đ95.000"
        android:textColor="@color/status_error"
        android:textSize="@dimen/text_size_body_primary"
        android:textStyle="bold" />

</LinearLayout>