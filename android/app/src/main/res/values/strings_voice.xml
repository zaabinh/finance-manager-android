    <!-- Help Sheet -->
    <string name="voice_help_title">Cách nói để FinTrack hiểu chuẩn</string>
    <string name="voice_help_formula_title">1. Công thức đơn giản nhất</string>
    <string name="voice_help_formula_desc">[Khoản gì] + [Bao nhiêu tiền] + [Bằng ví nào/Khi nào]</string>
    <string name="voice_help_examples_title">2. Một số ví dụ thường ngày</string>
    <string name="voice_help_example_item_1">• Chi tiêu: "Ăn phở 45k", "Cà phê 30 nghìn", "Đổ xăng 50k"</string>
    <string name="voice_help_example_item_2">• Ví &amp; Thẻ: "Quẹt thẻ 350k siêu thị", "Bắn momo 45k trà sữa"</string>
    <string name="voice_help_example_item_3">• Thời gian: "Hôm qua ăn tối 150k", "Hôm kia mua áo 200k"</string>
    <string name="voice_help_example_item_4">• Thu nhập: "Thu lương 15 triệu", "Được thưởng 500k"</string>
    <string name="voice_help_example_item_5">• Chuyển tiền: "Chuyển 500k sang ví Momo"</string>
    <string name="voice_help_slang_title">3. Hỗ trợ từ lóng &amp; cách đọc dân dã</string>
    <string name="voice_help_slang_desc">k, ngàn, lít (100k), lốp (100k), vé (100k), sọi (10k), củ (1 triệu), chai (1 triệu), rưỡi (50k/500k), hăm lăm (25k), năm nhăm (55k), trăm hai (120k)...</string>
    <string name="voice_help_btn_got_it">Đã hiểu, thử ngay!</string>
