<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base Style cho Typography -->
    <style name="TextAppearance.App" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">sans-serif</item> <!-- Hoặc sans-serif-medium / Roboto -->
    </style>

    <!-- Amount / Hero 30sp SemiBold -->
    <style name="TextAppearance.App.AmountHero">
        <item name="android:textSize">@dimen/text_size_amount_hero</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Amount / Medium 22sp SemiBold -->
    <style name="TextAppearance.App.AmountMedium">
        <item name="android:textSize">@dimen/text_size_amount_medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Title / Page 22sp SemiBold -->
    <style name="TextAppearance.App.TitlePage">
        <item name="android:textSize">@dimen/text_size_title_page</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Title / Section 16sp SemiBold -->
    <style name="TextAppearance.App.TitleSection">
        <item name="android:textSize">@dimen/text_size_title_section</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Body / Primary 14sp Regular -->
    <style name="TextAppearance.App.BodyPrimary">
        <item name="android:textSize">@dimen/text_size_body_primary</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Body / Secondary 13sp Regular -->
    <style name="TextAppearance.App.BodySecondary">
        <item name="android:textSize">@dimen/text_size_body_secondary</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Label 12sp Medium -->
    <style name="TextAppearance.App.Label">
        <item name="android:textSize">@dimen/text_size_label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Caption 11sp Regular -->
    <style name="TextAppearance.App.Caption">
        <item name="android:textSize">@dimen/text_size_caption</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_disabled</item>
    </style>

    <!-- Button 14sp SemiBold -->
    <style name="TextAppearance.App.Button">
        <item name="android:textSize">@dimen/text_size_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_primary</item>
    </style>

    <!-- ===== Widget styles from Figma v2 (P2 Button 185:802, Input 47:150, Feedback/Inline 628:2683) ===== -->

    <!-- Buttons: min 48dp, radius/medium, type/button -->
    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/spacing_16</item>
        <item name="android:paddingEnd">@dimen/spacing_16</item>
        <item name="cornerRadius">@dimen/radius_input_button</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="backgroundTint">@color/button_primary_bg</item>
        <item name="android:textColor">@color/button_on_filled_fg</item>
        <item name="iconTint">@color/button_on_filled_fg</item>
        <item name="rippleColor">@color/color_primary_pressed</item>
    </style>

    <style name="Widget.App.Button.Destructive" parent="Widget.App.Button.Primary">
        <item name="backgroundTint">@color/button_destructive_bg</item>
        <item name="rippleColor">@color/semantic_error_800</item>
    </style>

    <!-- Secondary = white + border/strong -->
    <style name="Widget.App.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/spacing_16</item>
        <item name="android:paddingEnd">@dimen/spacing_16</item>
        <item name="cornerRadius">@dimen/radius_input_button</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="backgroundTint">@color/bg_card_surface</item>
        <item name="strokeColor">@color/button_outline_stroke</item>
        <item name="strokeWidth">@dimen/divider_height</item>
        <item name="android:textColor">@color/button_neutral_fg</item>
        <item name="iconTint">@color/button_neutral_fg</item>
        <item name="rippleColor">@color/bg_surface_secondary</item>
    </style>

    <!-- Outline = brand-outlined secondary -->
    <style name="Widget.App.Button.Outline" parent="Widget.App.Button.Secondary">
        <item name="strokeColor">@color/button_brand_stroke</item>
        <item name="android:textColor">@color/button_brand_fg</item>
        <item name="iconTint">@color/button_brand_fg</item>
        <item name="rippleColor">@color/bg_brand_subtle</item>
    </style>

    <!-- Tertiary = text button (links such as "Quên mật khẩu?") -->
    <style name="Widget.App.Button.Tertiary" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/spacing_16</item>
        <item name="android:paddingEnd">@dimen/spacing_16</item>
        <item name="cornerRadius">@dimen/radius_input_button</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="android:textColor">@color/button_brand_fg</item>
        <item name="iconTint">@color/button_brand_fg</item>
        <item name="rippleColor">@color/bg_brand_subtle</item>
    </style>

    <!-- Input: label sits above the box (separate TextView), box min 52dp -->
    <style name="Widget.App.FieldLabel" parent="">
        <item name="android:textAppearance">@style/TextAppearance.App.Label</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:layout_marginBottom">@dimen/spacing_4</item>
    </style>

    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="hintEnabled">false</item>
        <item name="boxBackgroundColor">@color/bg_card_surface</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxStrokeWidth">@dimen/divider_height</item>
        <item name="boxStrokeWidthFocused">@dimen/border_width_focus</item>
        <item name="boxStrokeErrorColor">@color/status_error</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_input_button</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_input_button</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_input_button</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_input_button</item>
        <item name="startIconTint">@color/text_secondary</item>
        <item name="endIconTint">@color/text_secondary</item>
        <item name="errorIconTint">@color/status_error</item>
        <item name="errorTextColor">@color/status_error</item>
        <item name="errorTextAppearance">@style/TextAppearance.App.BodySecondary</item>
        <item name="helperTextTextAppearance">@style/TextAppearance.App.BodySecondary</item>
        <item name="helperTextTextColor">@color/text_secondary</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.TextInputEditText</item>
    </style>

    <style name="ThemeOverlay.App.TextInputEditText" parent="">
        <item name="editTextStyle">@style/Widget.App.TextInputEditText</item>
    </style>

    <style name="Widget.App.TextInputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:minHeight">@dimen/input_min_height</item>
        <item name="android:paddingStart">@dimen/spacing_12</item>
        <item name="android:paddingEnd">@dimen/spacing_12</item>
        <item name="android:paddingTop">@dimen/spacing_16</item>
        <item name="android:paddingBottom">@dimen/spacing_16</item>
        <item name="android:textAppearance">@style/TextAppearance.App.BodyPrimary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>

    <!-- Feedback/Inline tones (padding 12, radius/small) -->
    <style name="Widget.App.FeedbackInline" parent="">
        <item name="android:background">@drawable/bg_feedback_inline</item>
        <item name="android:padding">@dimen/spacing_12</item>
    </style>

    <style name="Widget.App.FeedbackInline.Info">
        <item name="android:backgroundTint">@color/bg_surface_secondary</item>
    </style>

    <style name="Widget.App.FeedbackInline.Success">
        <item name="android:backgroundTint">@color/status_success_bg</item>
    </style>

    <style name="Widget.App.FeedbackInline.Warning">
        <item name="android:backgroundTint">@color/status_warning_bg</item>
    </style>

    <style name="Widget.App.FeedbackInline.Error">
        <item name="android:backgroundTint">@color/status_error_bg</item>
    </style>

    <!-- Amounts: tabular numerals so digits align in lists (P1 handoff L4) -->
    <style name="Widget.App.TextView.Amount" parent="">
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- ===== Transaction UI components (Figma P3/P5, docs/frontend-ui/component-map.md) ===== -->

    <!-- Navigation/AppBar 364:1867: 52dp, surface, type/title/page -->
    <style name="Widget.App.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/app_bar_height</item>
        <item name="android:background">@color/bg_card_surface</item>
        <item name="titleTextAppearance">@style/TextAppearance.App.TitlePage</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="contentInsetStart">@dimen/spacing_16</item>
        <item name="contentInsetStartWithNavigation">0dp</item>
    </style>

    <!-- Type=Back. The back button keeps its 48dp touch target, so the title sits slightly right of Figma. -->
    <style name="Widget.App.Toolbar.Back">
        <item name="navigationIcon">@drawable/ic_arrow_back</item>
        <item name="navigationIconTint">@color/text_primary</item>
        <item name="navigationContentDescription">@string/action_back</item>
    </style>

    <!-- Control/Segmented 364:1866 segment (inside bg_segmented_track, 4dp padding/gap) -->
    <style name="Widget.App.Button.Segment" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">@dimen/segment_min_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/spacing_4</item>
        <item name="android:paddingEnd">@dimen/spacing_4</item>
        <item name="android:paddingTop">@dimen/spacing_8</item>
        <item name="android:paddingBottom">@dimen/spacing_8</item>
        <item name="android:checkable">true</item>
        <item name="android:maxLines">2</item>
        <item name="cornerRadius">@dimen/radius_xs</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="android:textColor">@color/segment_fg</item>
        <item name="backgroundTint">@color/segment_bg</item>
        <item name="rippleColor">@color/bg_brand_subtle</item>
    </style>

    <!-- Chip/Filter 628:2626: 32dp pill inside a 48dp touch target -->
    <style name="Widget.App.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipMinHeight">@dimen/chip_min_height</item>
        <item name="chipCornerRadius">@dimen/radius_full</item>
        <item name="chipBackgroundColor">@color/chip_filter_bg</item>
        <item name="chipStrokeColor">@color/chip_filter_stroke</item>
        <item name="chipStrokeWidth">@dimen/divider_height</item>
        <item name="android:textColor">@color/chip_filter_fg</item>
        <item name="android:textAppearance">@style/TextAppearance.App.BodyPrimary</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
        <item name="chipStartPadding">@dimen/spacing_4</item>
        <item name="chipEndPadding">@dimen/spacing_4</item>
        <item name="textStartPadding">@dimen/spacing_8</item>
        <item name="textEndPadding">@dimen/spacing_8</item>
    </style>

    <!-- Field/Selector 628:2477: icon + (label / value) + chevron, min 56dp. Error / Uncertain swap the background. -->
    <style name="Widget.App.FieldSelector" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/selector_min_height</item>
        <item name="android:paddingStart">@dimen/spacing_12</item>
        <item name="android:paddingEnd">@dimen/spacing_12</item>
        <item name="android:paddingTop">@dimen/spacing_4</item>
        <item name="android:paddingBottom">@dimen/spacing_4</item>
        <item name="android:background">@drawable/bg_field_selector</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.App.FieldSelector.Error">
        <item name="android:background">@drawable/bg_field_selector_error</item>
    </style>

    <style name="Widget.App.FieldSelector.Uncertain">
        <item name="android:background">@drawable/bg_field_selector_uncertain</item>
    </style>

    <style name="Widget.App.FieldSelector.Icon" parent="">
        <item name="android:layout_width">@dimen/icon_size_default</item>
        <item name="android:layout_height">@dimen/icon_size_default</item>
        <item name="android:layout_marginEnd">@dimen/spacing_8</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/text_secondary</item>
    </style>

    <style name="Widget.App.FieldSelector.Content" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Widget.App.FieldSelector.Label" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Label</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.App.FieldSelector.Label.Error">
        <item name="android:textColor">@color/status_error</item>
    </style>

    <style name="Widget.App.FieldSelector.Label.Uncertain">
        <item name="android:textColor">@color/status_warning</item>
    </style>

    <!-- Value. android:hint carries the empty-state placeholder (e.g. "Chọn danh mục"). -->
    <style name="Widget.App.FieldSelector.Value" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.App.BodyPrimary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Widget.App.FieldSelector.Chevron" parent="">
        <item name="android:layout_width">@dimen/icon_size_default</item>
        <item name="android:layout_height">@dimen/icon_size_default</item>
        <item name="android:layout_marginStart">@dimen/spacing_8</item>
        <item name="android:src">@drawable/ic_chevron_down</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- List/DataRow 658:4182 Inline: 104dp label + SemiBold value. Rules come from the container (showDividers=middle, divider_horizontal) so the last row does not double the card border. -->
    <style name="Widget.App.DataRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:paddingStart">@dimen/spacing_16</item>
        <item name="android:paddingEnd">@dimen/spacing_16</item>
        <item name="android:paddingTop">@dimen/spacing_14</item>
        <item name="android:paddingBottom">@dimen/spacing_14</item>
    </style>

    <style name="Widget.App.DataRow.Stacked">
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Widget.App.DataRow.Label" parent="">
        <item name="android:layout_width">@dimen/data_row_label_width</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">@dimen/spacing_16</item>
        <item name="android:textAppearance">@style/TextAppearance.App.BodyPrimary</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.App.DataRow.Label.Stacked">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_marginEnd">0dp</item>
        <item name="android:layout_marginBottom">@dimen/spacing_4</item>
    </style>

    <style name="Widget.App.DataRow.Value" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.App.DataRow.Value.Stacked">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_weight">0</item>
        <item name="android:textAppearance">@style/TextAppearance.App.BodyPrimary</item>
    </style>

    <!-- Feedback/Inline children, for fixed-tone placements inside screen layouts -->
    <style name="Widget.App.FeedbackInline.Icon" parent="">
        <item name="android:layout_width">@dimen/icon_small_size</item>
        <item name="android:layout_height">@dimen/icon_small_size</item>
        <item name="android:layout_marginEnd">@dimen/spacing_8</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="Widget.App.FeedbackInline.Message" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAppearance">@style/TextAppearance.App.BodySecondary</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Outlined card: detail summary / details and option groups (radius/large) -->
    <style name="Widget.App.CardOutlined" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card_outlined</item>
        <item name="android:divider">@drawable/divider_horizontal</item>
    </style>

    <!-- Bottom action area kept above the keyboard (activity needs windowSoftInputMode=adjustResize) -->
    <style name="Widget.App.BottomActionBar" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/spacing_16</item>
        <item name="android:paddingEnd">@dimen/spacing_16</item>
        <item name="android:paddingTop">@dimen/spacing_12</item>
        <item name="android:paddingBottom">@dimen/spacing_12</item>
        <item name="android:background">@color/bg_app_canvas</item>
    </style>
</resources>
