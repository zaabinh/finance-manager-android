    <!-- 03 · PALETTE — ĐỒNG · PRIMITIVE (Exact brief values with measured WCAG contrast) -->
    <!-- ============================================================ -->

    <!-- Green Brand -->
    <color name="green_brand_700">#246B43</color> <!-- white on it 6.44 · as text 6.44 ✓ -->
    <color name="green_brand_800">#1C5636</color> <!-- white on it 8.63 ✓ - pressed -->
    <color name="green_accent_500">#4CAF50</color> <!-- 2.78 on white ✗ text — accents/large only -->
    <color name="green_light_100">#E8F1EA</color> <!-- brand text on it 5.58 ✓ -->

    <!-- Neutrals (Nền & Chữ) -->
    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>
    <color name="neutral_canvas">#F6F8F5</color> <!-- text-900 on it 14.12 ✓ -->
    <color name="neutral_surface">#FFFFFF</color> <!-- cards, overlays -->
    <color name="neutral_surface_alt">#F0F4F0</color> <!-- text-600 on it 4.99 ✓ -->
    <color name="neutral_text_900">#1D2922</color> <!-- on white 15.08 ✓ -->
    <color name="neutral_text_600">#5D6C62</color> <!-- on white 5.55 · canvas 5.19 ✓ -->
    <color name="neutral_text_400">#98A69C</color> <!-- 2.54 — disabled only (exempt) -->
    <color name="neutral_border">#D6E2D9</color> <!-- 1.33 — dividers only -->
    <color name="neutral_border_strong">#7F8F84</color> <!-- 3.41 ✓ input outline (≥3:1) -->

    <!-- Semantics (Trạng thái) -->
    <color name="semantic_success">#287B47</color> <!-- on white 5.23 ✓ -->
    <color name="semantic_warning">#9B5A0B</color> <!-- white 5.44 · on warning-bg 4.95 ✓ -->
    <color name="semantic_warning_bg">#FFF3DE</color> <!-- due-soon surfaces -->
    <color name="semantic_error">#B73E36</color> <!-- white 5.59 · on error-bg 5.05 ✓ -->
    <color name="semantic_error_bg">#FFF0EE</color> <!-- error surfaces -->
    <color name="semantic_info">#2E68B5</color> <!-- on white 5.58 ✓ -->


