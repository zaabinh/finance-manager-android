<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Quyen truy cap internet, thong bao -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fintrack">

        <!-- Authentication Screens -->
        <activity
            android:name=".app.auth.ui.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.Fintrack"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".app.auth.ui.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".app.auth.ui.VerifyEmailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".app.auth.ui.ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".app.auth.ui.ChangePasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Home Screens -->
        <activity
            android:name=".app.home.ui.HomeDashboardActivity"
            android:exported="false" />

        <!-- Setting Screens -->
        <activity
            android:name=".app.settings.ui.SettingActivity"
            android:exported="false" />

        <activity
            android:name=".app.settings.ui.SettingUserActivity"
            android:exported="false" />

        <activity
            android:name=".app.settings.ui.SettingNotificationActivity"
            android:exported="false" />

        <activity
            android:name=".app.settings.ui.SettingSecurityActivity"
            android:exported="false" />

        <!-- Setup Screens -->
        <activity
            android:name=".app.setup.ui.SetupWelcomeActivity"
            android:exported="false" />

        <activity
            android:name=".app.setup.ui.SetupBasicInfoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".app.setup.ui.SetupNotificationActivity"
            android:exported="false" />

        <activity
            android:name=".app.setup.ui.SetupWalletActivity"
            android:exported="false" />

        <activity
            android:name=".app.setup.ui.SetupCompleteActivity"
            android:exported="false" />

        <!-- Wallet Screens -->
        <activity
            android:name=".app.wallet.ui.WalletListActivity"
            android:exported="false" />

        <activity
            android:name=".app.wallet.ui.WalletDetailActivity"
            android:exported="false" />

        <activity
            android:name=".app.wallet.ui.WalletAddActivity"
            android:exported="false" />

        <activity
            android:name=".app.wallet.ui.WalletEditActivity"
            android:exported="false" />

        <!-- Category Screens -->
        <activity
            android:name=".app.category.ui.CategoryListActivity"
            android:exported="false" />

        <activity
            android:name=".app.category.ui.CategoryAddActivity"
            android:exported="false" />

        <activity
            android:name=".app.category.ui.CategoryEditActivity"
            android:exported="false" />
    </application>

</manifest>