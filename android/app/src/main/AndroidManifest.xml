<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Quyen truy cap internet, thong bao -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fintrack">

        <!-- Authentication Screens -->
        <activity
            android:name=".app.auth.ui.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.Fintrack"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".app.auth.ui.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".app.auth.ui.VerifyEmailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".app.auth.ui.ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".app.auth.ui.ChangePasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Home Screens -->
        <activity android:name=".app.transaction.ui.TransactionListActivity" android:exported="false" />
        <activity android:name=".app.transaction.ui.TransactionDetailActivity" android:exported="false" />
        <activity android:name=".app.transaction.ui.TransactionFormActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".app.transaction.ui.ReceiptImportActivity" android:exported="false" />
        <activity android:name=".app.transaction.ui.ReceiptReviewActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".app.budget.ui.BudgetListActivity" android:exported="false" />
        <activity android:name=".app.budget.ui.BudgetDetailActivity" android:exported="false" />
        <activity android:name=".app.budget.ui.BudgetFormActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <provider android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.receipts" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/receipt_paths" />
        </provider>
        <activity
            android:name=".app.home.ui.HomeDashboardActivity"
            android:exported="false" />

        <!-- Setting Screens -->
        <activity
            android:name=".app.settings.ui.SettingActivity"
            android:exported="false" />

        <activity
            android:name=".app.settings.ui.SettingUserActivity"
            android:exported="false" />

        <activity
            android:name=".app.settings.ui.SettingNotificationActivity"
            android:exported="false" />

        <activity
            android:name=".app.settings.ui.SettingSecurityActivity"
            android:exported="false" />

        <!-- Setup Screens -->
        <activity
            android:name=".app.setup.ui.SetupWelcomeActivity"
            android:exported="false" />

        <activity
            android:name=".app.setup.ui.SetupBasicInfoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".app.setup.ui.SetupNotificationActivity"
            android:exported="false" />

        <activity
            android:name=".app.setup.ui.SetupWalletActivity"
            android:exported="false" />

        <activity
            android:name=".app.setup.ui.SetupCompleteActivity"
            android:exported="false" />
    </application>

</manifest>
