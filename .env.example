POSTGRES_DB=finance_manager_local
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
SPRING_PROFILES_ACTIVE=dev
AUTH_JWT_ISSUER=fintrack-api
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=30d
AUTH_OTP_TTL=10m
